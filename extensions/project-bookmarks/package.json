{
  "name": "project-bookmarks",
  "displayName": "Project Bookmarks",
  "description": "Bookmark projects (local, WSL, dev containers, SSH) and reopen them from a status bar icon.",
  "version": "0.0.2",
  "publisher": "local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "projectBookmarks.show",
        "title": "Show Bookmarks",
        "category": "Project Bookmarks",
        "icon": "$(bookmark)"
      },
      {
        "command": "projectBookmarks.addCurrent",
        "title": "Bookmark Current Project",
        "category": "Project Bookmarks"
      },
      {
        "command": "projectBookmarks.removeCurrent",
        "title": "Remove Current Project from Bookmarks",
        "category": "Project Bookmarks"
      },
      {
        "command": "projectBookmarks.openStorageFile",
        "title": "Open Bookmarks File",
        "category": "Project Bookmarks"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "projectBookmarks.addCurrent",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "projectBookmarks.removeCurrent",
          "when": "projectBookmarks.currentIsBookmarked"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs .",
    "watch": "node ../../scripts/build.mjs --watch .",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run build && npm run compile-tests",
    "test": "vscode-test",
    "vscode:prepublish": "node ../../scripts/build.mjs --production .",
    "package": "mkdir -p ../../packages && vsce package --no-dependencies --skip-license --allow-missing-repository --out ../../packages/"
  },
  "extensionKind": [
    "ui"
  ]
}
