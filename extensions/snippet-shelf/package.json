{
  "name": "snippet-shelf",
  "displayName": "Snippet Shelf",
  "description": "Your own categorized snippets (mainly git commands) in one JSON file shared by every profile and window, with git-aware variables, pickers and prompts.",
  "version": "0.0.4",
  "publisher": "local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "snippetShelf.show",
        "title": "Show Snippets",
        "category": "Snippet Shelf",
        "icon": "$(symbol-snippet)"
      },
      {
        "command": "snippetShelf.run",
        "title": "Run Snippet by Name",
        "category": "Snippet Shelf"
      },
      {
        "command": "snippetShelf.openFile",
        "title": "Edit Snippets File",
        "category": "Snippet Shelf",
        "icon": "$(edit)"
      },
      {
        "command": "snippetShelf.addFromSelection",
        "title": "Save Selection as Snippet",
        "category": "Snippet Shelf"
      },
      {
        "command": "snippetShelf.showVariables",
        "title": "Show Variable Values",
        "category": "Snippet Shelf"
      },
      {
        "command": "snippetShelf.addExamples",
        "title": "Add Example Snippets",
        "category": "Snippet Shelf"
      },
      {
        "command": "snippetShelf.tree.refresh",
        "title": "Refresh",
        "category": "Snippet Shelf",
        "icon": "$(refresh)"
      },
      {
        "command": "snippetShelf.tree.default",
        "title": "Run Default Action",
        "category": "Snippet Shelf",
        "icon": "$(debug-start)"
      },
      {
        "command": "snippetShelf.tree.run",
        "title": "Run in Terminal",
        "category": "Snippet Shelf",
        "icon": "$(play)"
      },
      {
        "command": "snippetShelf.tree.paste",
        "title": "Paste into Terminal (Don’t Run)",
        "category": "Snippet Shelf",
        "icon": "$(terminal)"
      },
      {
        "command": "snippetShelf.tree.insert",
        "title": "Insert into Editor",
        "category": "Snippet Shelf",
        "icon": "$(insert)"
      },
      {
        "command": "snippetShelf.tree.copy",
        "title": "Copy",
        "category": "Snippet Shelf",
        "icon": "$(copy)"
      },
      {
        "command": "snippetShelf.tree.open",
        "title": "Open in Browser",
        "category": "Snippet Shelf",
        "icon": "$(link-external)"
      },
      {
        "command": "snippetShelf.tree.reveal",
        "title": "Edit in Snippets File",
        "category": "Snippet Shelf",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "snippetShelf.addFromSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "snippetShelf.run",
          "when": "false"
        },
        {
          "command": "snippetShelf.tree.refresh",
          "when": "false"
        },
        {
          "command": "snippetShelf.tree.default",
          "when": "false"
        },
        {
          "command": "snippetShelf.tree.run",
          "when": "false"
        },
        {
          "command": "snippetShelf.tree.paste",
          "when": "false"
        },
        {
          "command": "snippetShelf.tree.insert",
          "when": "false"
        },
        {
          "command": "snippetShelf.tree.copy",
          "when": "false"
        },
        {
          "command": "snippetShelf.tree.reveal",
          "when": "false"
        },
        {
          "command": "snippetShelf.tree.open",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "snippetShelf.addFromSelection",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@9"
        }
      ],
      "view/title": [
        {
          "command": "snippetShelf.show",
          "when": "view == terminal",
          "group": "navigation@99"
        },
        {
          "command": "snippetShelf.show",
          "when": "view == snippetShelf.tree",
          "group": "navigation@1"
        },
        {
          "command": "snippetShelf.openFile",
          "when": "view == snippetShelf.tree",
          "group": "navigation@2"
        },
        {
          "command": "snippetShelf.tree.refresh",
          "when": "view == snippetShelf.tree",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "snippetShelf.tree.run",
          "when": "view == snippetShelf.tree && viewItem == snippet",
          "group": "inline@1"
        },
        {
          "command": "snippetShelf.tree.paste",
          "when": "view == snippetShelf.tree && viewItem == snippet",
          "group": "inline@2"
        },
        {
          "command": "snippetShelf.tree.insert",
          "when": "view == snippetShelf.tree && viewItem == snippet",
          "group": "inline@3"
        },
        {
          "command": "snippetShelf.tree.copy",
          "when": "view == snippetShelf.tree && viewItem == snippet",
          "group": "inline@4"
        },
        {
          "command": "snippetShelf.tree.open",
          "when": "view == snippetShelf.tree && viewItem == snippetOpen",
          "group": "inline@1"
        },
        {
          "command": "snippetShelf.tree.copy",
          "when": "view == snippetShelf.tree && viewItem == snippetOpen",
          "group": "inline@2"
        },
        {
          "command": "snippetShelf.tree.run",
          "when": "view == snippetShelf.tree && viewItem == snippet",
          "group": "1_actions@1"
        },
        {
          "command": "snippetShelf.tree.paste",
          "when": "view == snippetShelf.tree && viewItem == snippet",
          "group": "1_actions@2"
        },
        {
          "command": "snippetShelf.tree.insert",
          "when": "view == snippetShelf.tree && viewItem == snippet",
          "group": "1_actions@3"
        },
        {
          "command": "snippetShelf.tree.copy",
          "when": "view == snippetShelf.tree && viewItem == snippet",
          "group": "1_actions@4"
        },
        {
          "command": "snippetShelf.tree.open",
          "when": "view == snippetShelf.tree && viewItem == snippetOpen",
          "group": "1_actions@1"
        },
        {
          "command": "snippetShelf.tree.copy",
          "when": "view == snippetShelf.tree && viewItem == snippetOpen",
          "group": "1_actions@2"
        },
        {
          "command": "snippetShelf.tree.reveal",
          "when": "view == snippetShelf.tree && viewItem =~ /^snippet/",
          "group": "2_edit@1"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.snippet-shelf.jsonc",
        "url": "./schemas/snippets.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "snippetShelf",
          "title": "Snippet Shelf",
          "icon": "media/snippets.svg"
        }
      ]
    },
    "views": {
      "snippetShelf": [
        {
          "id": "snippetShelf.tree",
          "name": "Snippets",
          "icon": "media/snippets.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "snippetShelf.tree",
        "contents": "No snippets yet.\n[Edit Snippets File](command:snippetShelf.openFile)\n[Add Example Snippets](command:snippetShelf.addExamples)"
      }
    ],
    "keybindings": [
      {
        "command": "snippetShelf.tree.default",
        "key": "enter",
        "when": "focusedView == snippetShelf.tree"
      }
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs .",
    "watch": "node ../../scripts/build.mjs --watch .",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run build && npm run compile-tests",
    "test": "vscode-test",
    "vscode:prepublish": "node ../../scripts/build.mjs --production .",
    "package": "mkdir -p ../../packages && vsce package --no-dependencies --skip-license --allow-missing-repository --out ../../packages/"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "extensionKind": [
    "ui"
  ]
}
