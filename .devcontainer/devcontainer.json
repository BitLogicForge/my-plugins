{
  // ${localWorkspaceFolderBasename} - composed from .devcontainer/recipe.jsonc
  // stack: node | node_modules: project | sync: scripts | ports: vite, express | features: caddy_ca | agents: shared | extensions: node | settings: node
  //
  // On every start copy_config.sh rebuilds this file from the recipe and the current parts:
  // edit .devcontainer/recipe.jsonc (options: compose_config.py list), not this file.
  //
  // GENERATED by dev_scripts/compose/compose_config.py from parts: base, user_node, npm_global, node, ext_node, settings_node, node_modules_project, ports_vite, ports_express, sync_scripts, caddy_ca, agents_shared

  // Window title in VS Code
  "name": "${localWorkspaceFolderBasename}",
  // Built on the Windows host: images\build_images.bat node (see images/readme.md)
  "image": "my-node-dev:26",
  // --name: Docker container name (must be unique); --network: shared-dev lets dev containers
  // reach each other by container name (created by images\build_images.bat)
  "runArgs": [
    "--name=${localWorkspaceFolderBasename}-dev",
    "--network=shared-dev"
  ],
  // Env for the whole container; visible in `docker inspect`, so never put secrets here.
  // PROJECTPATH is required by the dev_scripts helpers
  "containerEnv": {
    // Project root; used by every dev_scripts helper
    "PROJECTPATH": "/workspaces/${localWorkspaceFolderBasename}",
    // Global npm packages go to the npm-global-node volume
    "NPM_CONFIG_PREFIX": "/home/node/.npm-global",
    // File watching by polling: inotify events do not cross the Windows bind mount
    "CHOKIDAR_USEPOLLING": "true"
  },
  // Env for VS Code, its terminals and the agents it starts (${localEnv:X} reads host env vars)
  "remoteEnv": {
    // n8n MCP server bearer token (used by .mcp.json); set on the host, never commit it
    "N8N_MCP_TOKEN": "${localEnv:N8N_MCP_TOKEN}",
    "PATH": "/home/node/.npm-global/bin:${containerEnv:PATH}",
    // Trust the homelab Caddy local CA (https://*.lan, e.g. the n8n MCP server); fetched into the shared devScripts volume by fetch_caddy_ca.sh
    "NODE_EXTRA_CA_CERTS": "/workspaces/dev_scripts/certs/caddy-root.crt"
  },
  // Must be the image user: node for my-node-dev, vscode for every other image
  "remoteUser": "node",
  // Where the project is mounted and opened inside the container
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  // Named volumes survive rebuilds. Volumes named after the project are per project;
  // the others are shared by every container that mounts them
  "mounts": [
    // Per-project node_modules: much faster than on the Windows bind mount
    "source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    // This repo's dev_scripts/: hook scripts, shared and live in every container
    "source=devScripts,target=/workspaces/dev_scripts,type=volume",
    // Global npm packages, shared by all containers
    "source=npm-global-node,target=/home/node/.npm-global,type=volume",
    // Claude Code login, settings, skills and MCP servers, shared by all containers
    "source=claude-config,target=/home/node/.claude,type=volume",
    // Codex login, config.toml (MCP servers), sessions and skills, shared by all containers
    "source=codex-config,target=/home/node/.codex,type=volume",
    // Antigravity (agy) login, settings and MCP servers, shared by all containers
    "source=agy-config,target=/home/node/.gemini,type=volume"
  ],
  // Once, when the container is created (before VS Code attaches)
  //   setup_agents.sh: make ~/.claude, ~/.codex, ~/.gemini volumes owned by the container user
  //   setup_node.sh: give the node user ownership of the node_modules volume
  "onCreateCommand": "/workspaces/dev_scripts/setup_agents.sh && /workspaces/dev_scripts/setup_node.sh",
  // Once, after creation: git user name/email (setup_git.sh)
  "postCreateCommand": "/workspaces/dev_scripts/post_create.sh",
  // On every start, in order:
  //   post_start.sh: warn if the git branch is behind origin
  //   copy_config.sh: rebuild devcontainer.json from .devcontainer/recipe.jsonc (nothing without a recipe)
  //   fetch_caddy_ca.sh: download Caddy's root.crt (http://apps.lan/root.crt) to dev_scripts/certs/ (NODE_EXTRA_CA_CERTS)
  //   sync_package_json.sh: sync package.json "scripts" from the template
  "postStartCommand": "/workspaces/dev_scripts/post_start.sh && /workspaces/dev_scripts/copy_config.sh && /workspaces/dev_scripts/fetch_caddy_ca.sh && /workspaces/dev_scripts/sync_package_json.sh scripts",
  // Ports forwarded to the host (http://localhost:<port>)
  "forwardPorts": [
    5173,
    4173,
    3000,
    3001
  ],
  // Labels for the Ports view; silent = forward without a popup
  "portsAttributes": {
    "5173": {
      "label": "Vite dev server",
      "onAutoForward": "silent",
      "protocol": "http"
    },
    "4173": {
      "label": "Vite preview",
      "onAutoForward": "silent"
    },
    "3000": {
      "label": "Express api",
      "onAutoForward": "silent",
      "protocol": "http"
    },
    "3001": {
      "label": "demoapp",
      "onAutoForward": "silent"
    }
  },
  // VS Code extensions and settings installed inside the container
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer"
      ],
      "settings": {
        "eslint.validate": [
          "javascript",
          "javascriptreact",
          "typescript",
          "typescriptreact"
        ]
      }
    }
  }
}
