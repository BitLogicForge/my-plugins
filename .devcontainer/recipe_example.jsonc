// Recipe with every option - GENERATED from dev_scripts/compose/catalog.jsonc, do not edit
// (regenerate: python3 config_scripts/build_containers.py).
// Use: copy to <project>/.devcontainer/recipe.jsonc, uncomment one "stack" and the lines you
// want (one line per group). Only what you list is applied: a group left out adds nothing.
// [stacks] after an option = only for those stacks. Trailing commas are fine. Preview with
// python3 /workspaces/dev_scripts/compose/compose_config.py build
{
  // ── stack: pick one (required) ──────────────────────────────────────────────────
  // "stack": "node",       // Node (my-node-dev:26, user node): Vite/Express/Next.js
  // "stack": "python",     // Python (my-python-dev:13, user vscode): uv + per-project .venv
  // "stack": "dotnet",     // .NET (dotnet:11, user vscode; also has Node, Python + uv and the agents; feature "python" adds a .venv)
  // "stack": "ollama",     // Ollama (my-ollama-dev:13 = my-python-dev:13 + ollama, user vscode): local LLMs, uv + .venv
  // "stack": "comfyui",    // ComfyUI (comfyui:13 = my-python-dev:13 + ComfyUI/torch CUDA in ~/ComfyUI, user vscode): UI on :8188
  // "stack": "admin",      // Admin/ops (my-admin-dev:13): Python + Ansible + Proxmox MCP server

  // ── container (optional) ────────────────────────────────────────────────────────
  // Window/container name; the Docker container gets "-dev" appended.
  // Default: node <project>, python <project>-python, dotnet <project>-dotnet, ollama <project>-ollama, comfyui <project>-comfyui, admin <project>-admin
  // "container": "my-app",

  // ── node_modules: pick one [node] ───────────────────────────────────────────────
  // node_modules volume
  // "node_modules": "project",          // per-project volume <project>-node_modules
  // "node_modules": "vite_shared",      // one volume shared by all projects (use with sync: all three sections)
  // "node_modules": "nextjs_shared",    // shared volume for Next.js projects with compatible deps

  // ── sync: pick any (list) [node] ────────────────────────────────────────────────
  // package.json sections synced from dev_scripts/templates/package.json on start ([] = no sync)
  //   scripts          overwrite "scripts"
  //   dependencies     overwrite "dependencies"
  //   devDependencies  overwrite "devDependencies"
  // "sync": ["scripts", "dependencies", "devDependencies"],
  // "sync": [],
  //   (old value "all" still works = ["scripts", "dependencies", "devDependencies"])
  //   (old value "none" still works = [])

  // ── uv_cache: pick one [python, ollama] ─────────────────────────────────────────
  // uv download cache volume
  // "uv_cache": "project",    // per-project volume
  // "uv_cache": "shared",     // shared-uv-cache volume (saves disk/downloads)

  // ── ports: pick any (list) [node, python, dotnet, ollama, comfyui] ──────────────
  // forwarded ports
  //   vite             5173 / 4173
  //   express          3000 / 3001
  //   nextjs           3000 (Next.js)
  //   fastapi          8000
  //   ollama           11434 (Ollama API)  [ollama]
  //   comfyui          8188 (ComfyUI)  [comfyui]
  // "ports": ["vite", "express", "nextjs", "fastapi", "ollama", "comfyui"],
  // "ports": [],

  // ── features: pick any (list) ───────────────────────────────────────────────────
  // optional features
  //   caddy_ca         trust the homelab Caddy local CA
  //   gpu              NVIDIA GPU (--gpus=all; container fails to start without NVIDIA support)  [ollama, comfyui]
  //   workspace_volume source code in a <project>-src volume instead of the Windows bind mount
  //   nextjs           Next.js editor setup + polling file watcher  [node]
  //   python           Python dev: uv + per-project .venv and uv cache volumes (add extensions/settings "python")  [dotnet]
  //   python_db        database drivers/server as Dev Container features  [python]
  //   admindb          DB/workflow admin: PostgreSQL client env (~/.pgpass) + n8n API + n8n MCP server (includes python_db)  [python]  (needs agents: admindb | isolated)
  // "features": ["caddy_ca", "gpu", "workspace_volume", "nextjs", "python", "python_db", "admindb"],
  // "features": [],

  // ── agents: pick one ────────────────────────────────────────────────────────────
  // AI agent config volumes (Claude, Codex, agy)
  // "agents": "shared",      // shared with all containers: log in once  [node, python, dotnet, ollama, comfyui]
  // "agents": "isolated",    // per-project volumes: nothing shared
  // "agents": "admin",       // Codex/agy on admin-only volumes (proxmox MCP)  [admin]
  // "agents": "admindb",     // Codex/agy on admindb-only volumes (n8n MCP)  [python]  (needs features: admindb)

  // ── extensions: pick any (list) ─────────────────────────────────────────────────
  // VS Code extension presets (only those picked)
  //   node             ESLint, Prettier, Vitest
  //   python           basedpyright, Python, Ruff
  //   admin            Ansible, Jinja, agents, TOML/dotenv/shellcheck, icons  [admin]
  // "extensions": ["node", "python", "admin"],
  // "extensions": [],

  // ── settings: pick any (list) ───────────────────────────────────────────────────
  // VS Code settings presets (only those picked)
  //   node             ESLint validates JS/TS(X)
  //   python           basedpyright as language server, .venv interpreter
  //   admin            Ansible paths/lint, YAML file associations, icon theme  [admin]
  // "settings": ["node", "python", "admin"],
  // "settings": [],

  // ── vscode (optional): this project's own extensions and settings ───────────────
  // Added on top of the stack's. "-publisher.id" removes an extension the stack adds;
  // a setting set to null removes it. Uncomment the whole block.
  // "vscode": {
  //   "extensions": ["esbenp.prettier-vscode", "-ms-python.black-formatter"],
  //   "settings": { "editor.formatOnSave": true, "editor.rulers": [100] }
  // },
}
