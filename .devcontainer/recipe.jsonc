// Container recipe: dev_scripts/copy_config.sh rebuilds devcontainer.json from this file
// on every start. After editing run "Dev Containers: Rebuild Container" (or first
// python3 /workspaces/dev_scripts/compose/compose_config.py build to preview).
// All options: python3 /workspaces/dev_scripts/compose/compose_config.py list
// or the commented example /workspaces/dev_scripts/compose/recipe_example.jsonc
{
  // Node (my-node-dev:26, user node): Vite/Express/Next.js
  "stack": "node",
  // node_modules volume - one of: project | vite_shared | nextjs_shared
  "node_modules": "project",
  // package.json sections synced from dev_scripts/templates/package.json on start ([] = no sync) - any of: scripts | dependencies | devDependencies
  "sync": [],
  // forwarded ports - any of: vite | express | nextjs | fastapi
  "ports": [],
  // optional features - any of: caddy_ca | workspace_volume | nextjs
  "features": [
    "caddy_ca",
    "workspace_volume"
  ],
  // AI agent config volumes (Claude, Codex, agy) - one of: shared | isolated
  "agents": "shared",
  // VS Code extension presets (only those picked) - any of: node | python
  "extensions": [
    "node"
  ],
  // VS Code settings presets (only those picked) - any of: node | python
  "settings": [
    "node"
  ]
}